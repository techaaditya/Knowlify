# Backend API base URL
VITE_API_URL=http://localhost:8000

# Optional engine keys (only if the backend enforces them)
# VITE_ADAPTIVE_API_KEY=
# VITE_CHATBOT_API_KEY=

# Google Sign-In (OAuth Web client id from Google Cloud Console).
# Must match GOOGLE_CLIENT_ID in the backend .env. When empty, the
# "Continue with Google" button renders a disabled fallback.
# VITE_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
