# Ollama Configuration
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_API_KEY=

# Adaptive Engine demo key.
# Leave empty for local demos without auth, or set a value and send it
# from the frontend as VITE_ADAPTIVE_API_KEY.
ADAPTIVE_API_KEY=

# Chatbot LLM Configuration (separate key for the adaptive tutor)
CHAT_API_KEY=
CHATBOT_API_KEY=
CHAT_MODEL="gpt-oss:120b-cloud"
CHAT_FALLBACK_MODEL="llama3.2:3b"

# Database Configuration
# SQLite for local dev; use PostgreSQL when running via docker-compose
DATABASE_URL=sqlite:///./knowlify.db
# DATABASE_URL=postgresql://postgres:postgrespassword@localhost:5432/knowlify

# Server Configuration
PORT=8000
HOST=0.0.0.0

# Authentication
# Secret used to sign JWT session tokens. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
# If empty, a random secret is generated per process (dev only — tokens are
# invalidated on every restart).
JWT_SECRET=
# Session lifetime in seconds (default 7 days).
JWT_EXPIRE_SECONDS=604800
# OAuth client id from Google Cloud Console (Web application). Required for the
# "Continue with Google" button. Use the SAME value as VITE_GOOGLE_CLIENT_ID.
GOOGLE_CLIENT_ID=
# Base URL of the frontend, used to build password-reset links.
FRONTEND_URL=http://localhost:5173
